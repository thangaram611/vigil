# /etc/newsyslog.d/vigil.conf — generated by `vigil setup`
#
# Rotates the bash daemon's primary log file (daemon.log). Does NOT touch
# daemon.out.log / daemon.err.log: those are held open by launchd's
# StandardOutPath / StandardErrorPath FDs, so rotation would leave launchd
# writing to the rotated file. The bash log() helper (lib/common.sh) reopens
# the path on every line, so rotation needs no SIGHUP handling.
#
# Rotates at 1 MiB, keeps 5 generations, gzipped. `*` in the "when" column means
# size-only, evaluated whenever com.apple.newsyslog fires (~hourly).
#
# logfilename                  owner:group        mode  count  size  when  flags
@VIGIL_LOG_FILE@               @VIGIL_USER@:staff 644   5      1024  *     GZ
