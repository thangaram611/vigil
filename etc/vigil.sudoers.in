# /etc/sudoers.d/vigil
#
# Generated by `vigil setup`. Allows the user @USER@ to flip
# pmset's SleepDisabled flag without an interactive password prompt.
#
# Why exactly these two commands and nothing else:
#   - vigil-daemon needs to run `pmset -a disablesleep 0|1` from launchd,
#     which has no controlling tty and therefore can't accept a password.
#   - All other privileged operations (install, uninstall, sudoers edit)
#     happen interactively via `vigil setup` / `vigil uninstall` and use
#     normal sudo with prompting — they don't need a NOPASSWD rule.
#   - Argv must match exactly. No wildcards in the command list.

@USER@ ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1
