<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thangaram.vigil</string>

    <key>ProgramArguments</key>
    <array>
        <string>@VIGIL_DAEMON_PATH@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- ExitTimeOut: seconds launchd waits between SIGTERM and SIGKILL on stop.
         Default is system-defined (~20s on recent macOS) which is tight for our
         cleanup path: helper release, kill caffeinate, drop baseline, release
         lock. 60s gives the SIGTERM handler comfortable headroom under load. -->
    <key>ExitTimeOut</key>
    <integer>60</integer>

    <!-- ThrottleInterval: minimum seconds between successive spawns of this job
         when KeepAlive is true. 10s is launchd's documented default — set
         explicitly for documentation and to insulate against future macOS
         changes to the implicit default. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@VIGIL_LOG_DIR@/daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>@VIGIL_LOG_DIR@/daemon.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>VIGIL_STATE_DIR</key>
        <string>@VIGIL_STATE_DIR@</string>
        <key>VIGIL_LOG_DIR</key>
        <string>@VIGIL_LOG_DIR@</string>
    </dict>
</dict>
</plist>
