#!/usr/bin/env bash
# bin/vigil — main CLI dispatcher.
#
# Subcommands:
#   setup, uninstall, start, stop, status, log, run, reload, doctor, lock,
#   --version

set -euo pipefail

# ---- locate libs and source them ---------------------------------------------
# Resolve the script's real path even when invoked via a symlink (e.g. from
# ~/.local/bin/vigil). Without this, _self_dir lands in ~/.local/bin and we
# fail to find lib/.
_resolve_self() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir; dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
_self_dir="$(_resolve_self)"
VIGIL_REPO_ROOT="$(cd "$_self_dir/.." && pwd)"
export VIGIL_REPO_ROOT
VIGIL_LIB_DIR="$VIGIL_REPO_ROOT/lib"
# shellcheck source=../lib/common.sh
source "$VIGIL_LIB_DIR/common.sh"
# shellcheck source=../lib/refcount.sh
source "$VIGIL_LIB_DIR/refcount.sh"
# shellcheck source=../lib/detect.sh
source "$VIGIL_LIB_DIR/detect.sh"
# shellcheck source=../lib/activity.sh
source "$VIGIL_LIB_DIR/activity.sh"
# shellcheck source=../lib/pmset.sh
source "$VIGIL_LIB_DIR/pmset.sh"
# shellcheck source=../lib/thermal.sh
source "$VIGIL_LIB_DIR/thermal.sh"
# shellcheck source=../lib/battery.sh
source "$VIGIL_LIB_DIR/battery.sh"

vigil_load_config

# ---- constants ---------------------------------------------------------------
VIGIL_LABEL="com.thangaram.vigil"
VIGIL_HELPER_LABEL="com.thangaram.vigil.helper"
VIGIL_PLIST="$HOME/Library/LaunchAgents/${VIGIL_LABEL}.plist"
VIGIL_HELPER_PLIST="/Library/LaunchDaemons/${VIGIL_HELPER_LABEL}.plist"
VIGIL_LEGACY_SUDOERS_FILE="/etc/sudoers.d/vigil"
VIGIL_VERSION="0.1.0-dev"

# ---- helpers -----------------------------------------------------------------

cmd_sed_escape_replacement() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//&/\\&}"
    value="${value//|/\\|}"
    printf '%s' "$value"
}

cmd_xml_escape() {
    local value="$1"
    value="${value//&/&amp;}"
    value="${value//</&lt;}"
    value="${value//>/&gt;}"
    value="${value//\"/&quot;}"
    value="${value//\'/&apos;}"
    printf '%s' "$value"
}

cmd_plist_escape() {
    cmd_sed_escape_replacement "$(cmd_xml_escape "$1")"
}

cmd_require_admin_allowed() {
    if [[ "${VIGIL_TEST_NO_ADMIN:-0}" == "1" ]]; then
        die "admin operation blocked by VIGIL_TEST_NO_ADMIN"
    fi
}

cmd_assert_vigil_tree_path() {
    local label="$1" path="$2" base
    [[ "$path" == /* ]] || die "refusing unsafe $label path (not absolute): $path"
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || die "refusing unsafe $label path containing a newline"
    [[ "$path" != "/" ]] || die "refusing unsafe $label path: /"
    [[ "$path" != "$HOME" ]] || die "refusing unsafe $label path equal to HOME: $path"
    base="${path##*/}"
    [[ "$base" == "vigil" ]] || die "refusing unsafe $label path (must end in /vigil): $path"
}

cmd_assert_standard_privileged_paths() {
    local root="/Library/Application Support/vigil"
    [[ "$VIGIL_ROOT_DIR" == "$root" ]] || die "refusing non-standard VIGIL_ROOT_DIR for privileged operation: $VIGIL_ROOT_DIR"
    [[ "$VIGIL_ROOT_BIN_DIR" == "$root/bin" ]] || die "refusing non-standard VIGIL_ROOT_BIN_DIR for privileged operation: $VIGIL_ROOT_BIN_DIR"
    [[ "$VIGIL_ROOT_HELPER" == "$root/bin/vigil-root-helper" ]] || die "refusing non-standard VIGIL_ROOT_HELPER for privileged operation: $VIGIL_ROOT_HELPER"
    [[ "$VIGIL_POWER_HELPER_DIR" == "$root/helper" ]] || die "refusing non-standard VIGIL_POWER_HELPER_DIR for privileged operation: $VIGIL_POWER_HELPER_DIR"
    [[ "$VIGIL_POWER_REQUEST_BASE" == "$root/helper/requests" ]] || die "refusing non-standard VIGIL_POWER_REQUEST_BASE for privileged operation: $VIGIL_POWER_REQUEST_BASE"
    [[ "$VIGIL_POWER_RESPONSE_BASE" == "$root/helper/responses" ]] || die "refusing non-standard VIGIL_POWER_RESPONSE_BASE for privileged operation: $VIGIL_POWER_RESPONSE_BASE"
    [[ "$VIGIL_POWER_REQUEST_DIR" == "$root/helper/requests/$(id -u)" ]] || die "refusing non-standard VIGIL_POWER_REQUEST_DIR for privileged operation: $VIGIL_POWER_REQUEST_DIR"
    [[ "$VIGIL_POWER_RESPONSE_DIR" == "$root/helper/responses/$(id -u)" ]] || die "refusing non-standard VIGIL_POWER_RESPONSE_DIR for privileged operation: $VIGIL_POWER_RESPONSE_DIR"
    [[ "$VIGIL_POWER_STATE_DIR" == "$root/helper/state" ]] || die "refusing non-standard VIGIL_POWER_STATE_DIR for privileged operation: $VIGIL_POWER_STATE_DIR"
    [[ "$VIGIL_POWER_LOG_DIR" == "$root/helper/logs" ]] || die "refusing non-standard VIGIL_POWER_LOG_DIR for privileged operation: $VIGIL_POWER_LOG_DIR"
    [[ "$VIGIL_POWER_LOG_FILE" == "$root/helper/logs/helper.log" ]] || die "refusing non-standard VIGIL_POWER_LOG_FILE for privileged operation: $VIGIL_POWER_LOG_FILE"
    [[ "$VIGIL_HELPER_PLIST" == "/Library/LaunchDaemons/${VIGIL_HELPER_LABEL}.plist" ]] || die "refusing non-standard helper plist path: $VIGIL_HELPER_PLIST"
    [[ "$VIGIL_NEWSYSLOG_FILE" == "/etc/newsyslog.d/vigil.conf" ]] || die "refusing non-standard newsyslog path: $VIGIL_NEWSYSLOG_FILE"
    [[ "$VIGIL_LEGACY_SUDOERS_FILE" == "/etc/sudoers.d/vigil" ]] || die "refusing non-standard legacy sudoers path: $VIGIL_LEGACY_SUDOERS_FILE"
}

cmd_render_plist() {
    # Substitute placeholders in the plist template. The daemon path points to
    # $VIGIL_INSTALL_DIR (NOT the source repo) — see the TCC note in common.sh.
    local in="$VIGIL_REPO_ROOT/etc/com.thangaram.vigil.plist.in"
    local daemon="$VIGIL_INSTALL_DIR/bin/vigil-daemon"
    local daemon_xml log_dir_xml state_dir_xml
    daemon_xml=$(cmd_plist_escape "$daemon")
    log_dir_xml=$(cmd_plist_escape "$VIGIL_LOG_DIR")
    state_dir_xml=$(cmd_plist_escape "$VIGIL_STATE_DIR")
    sed \
        -e "s|@VIGIL_DAEMON_PATH@|$daemon_xml|g" \
        -e "s|@VIGIL_LOG_DIR@|$log_dir_xml|g" \
        -e "s|@VIGIL_STATE_DIR@|$state_dir_xml|g" \
        "$in"
}

# Sync the daemon + libs from the source repo into $VIGIL_INSTALL_DIR. This
# is the path the LaunchAgent points at (because launchd can't execute under
# ~/Documents/ without TCC consent).
cmd_cargo_target_dir() {
    local cargo_toml="$1" metadata target_dir
    metadata=$(cargo metadata --format-version 1 --no-deps --manifest-path "$cargo_toml") || return 1
    target_dir=$(printf '%s\n' "$metadata" | sed -nE 's/.*"target_directory":"([^"]+)".*/\1/p')
    [[ -n "$target_dir" ]] || {
        echo "  failed to resolve cargo target directory for $cargo_toml"
        return 1
    }
    printf '%s\n' "$target_dir"
}

cmd_sync_install() {
    mkdir -p "$VIGIL_INSTALL_DIR/bin" "$VIGIL_INSTALL_DIR/lib"
    install -m 0755 "$VIGIL_REPO_ROOT/bin/vigil-daemon" "$VIGIL_INSTALL_DIR/bin/vigil-daemon"
    install -m 0644 "$VIGIL_REPO_ROOT/lib/"*.sh "$VIGIL_INSTALL_DIR/lib/"
    echo "  daemon: installed to $VIGIL_INSTALL_DIR/bin/vigil-daemon"

    if [[ "$(uname -s)" == "Darwin" ]]; then
        local cargo_toml="$VIGIL_REPO_ROOT/native/vigil-lock-helper/Cargo.toml"
        local target_dir build_bin
        target_dir=$(cmd_cargo_target_dir "$cargo_toml") || return 1
        build_bin="$target_dir/release/vigil-lock-helper"
        if ! cargo build --quiet --release --manifest-path "$cargo_toml"; then
            echo "  failed to build vigil-lock-helper (see above)"
            return 1
        fi
        if [[ ! -x "$build_bin" ]]; then
            echo "  failed to find built vigil-lock-helper at $build_bin"
            return 1
        fi
        install -m 0755 "$build_bin" "$VIGIL_INSTALL_DIR/bin/vigil-lock-helper"
        echo "  lock helper: installed to $VIGIL_INSTALL_DIR/bin/vigil-lock-helper"
    fi
}

cmd_render_helper_plist() {
    local in="$VIGIL_REPO_ROOT/etc/com.thangaram.vigil.helper.plist.in"
    local user uid
    user=$(id -un)
    uid=$(id -u)
    sed \
        -e "s|@VIGIL_ROOT_HELPER@|$(cmd_plist_escape "$VIGIL_ROOT_HELPER")|g" \
        -e "s|@VIGIL_POWER_REQUEST_DIR@|$(cmd_plist_escape "$VIGIL_POWER_REQUEST_DIR")|g" \
        -e "s|@VIGIL_POWER_RESPONSE_DIR@|$(cmd_plist_escape "$VIGIL_POWER_RESPONSE_DIR")|g" \
        -e "s|@VIGIL_POWER_STATE_DIR@|$(cmd_plist_escape "$VIGIL_POWER_STATE_DIR")|g" \
        -e "s|@VIGIL_POWER_LOG_DIR@|$(cmd_plist_escape "$VIGIL_POWER_LOG_DIR")|g" \
        -e "s|@VIGIL_POWER_LOG_FILE@|$(cmd_plist_escape "$VIGIL_POWER_LOG_FILE")|g" \
        -e "s|@VIGIL_ALLOWED_UID@|$uid|g" \
        -e "s|@VIGIL_ALLOWED_USER@|$(cmd_plist_escape "$user")|g" \
        "$in"
}

cmd_render_newsyslog() {
    # Substitute placeholders in the newsyslog.d template. Uses the RUNTIME
    # values of VIGIL_LOG_FILE and the current user, so a vigil.conf override
    # of VIGIL_LOG_DIR is picked up correctly (vigil_load_config derives
    # VIGIL_LOG_FILE from VIGIL_LOG_DIR).
    local in="$VIGIL_REPO_ROOT/etc/vigil.newsyslog.in"
    local user; user=$(id -un)
    sed \
        -e "s|@VIGIL_LOG_FILE@|$VIGIL_LOG_FILE|g" \
        -e "s|@VIGIL_USER@|$user|g" \
        "$in"
}

cmd_install_root_helper() {
    local user group tmp_plist
    cmd_require_admin_allowed
    cmd_assert_standard_privileged_paths
    user=$(id -un)
    group=$(id -gn)
    tmp_plist=$(mktemp -t vigil-helper-plist)
    cmd_render_helper_plist > "$tmp_plist"
    chmod 0644 "$tmp_plist"

    echo "     root helper: installing LaunchDaemon (sudo may prompt)"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_ROOT_DIR"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_ROOT_BIN_DIR"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_POWER_HELPER_DIR"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_POWER_REQUEST_BASE"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_POWER_RESPONSE_BASE"
    sudo install -d -m 0700 -o root -g wheel "$VIGIL_POWER_STATE_DIR"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_POWER_LOG_DIR"
    sudo install -d -m 0700 -o "$user" -g "$group" "$VIGIL_POWER_REQUEST_DIR"
    sudo install -d -m 0755 -o root -g wheel "$VIGIL_POWER_RESPONSE_DIR"
    sudo install -m 0755 -o root -g wheel "$VIGIL_REPO_ROOT/bin/vigil-root-helper" "$VIGIL_ROOT_HELPER"
    sudo install -m 0644 -o root -g wheel "$tmp_plist" "$VIGIL_HELPER_PLIST"
    rm -f "$tmp_plist"

    sudo launchctl bootout "system/$VIGIL_HELPER_LABEL" >/dev/null 2>&1 || true
    sudo launchctl bootstrap system "$VIGIL_HELPER_PLIST"
    sudo launchctl enable "system/$VIGIL_HELPER_LABEL" 2>/dev/null || true
    echo "     root helper: bootstrapped $VIGIL_HELPER_LABEL"
}

cmd_remove_root_helper() {
    cmd_require_admin_allowed
    cmd_assert_standard_privileged_paths
    echo "     root helper: removing LaunchDaemon and helper files (sudo may prompt)"
    sudo launchctl bootout "system/$VIGIL_HELPER_LABEL" >/dev/null 2>&1 || true
    [[ -f "$VIGIL_HELPER_PLIST" ]] && sudo rm -f "$VIGIL_HELPER_PLIST"
    [[ -d "$VIGIL_POWER_HELPER_DIR" ]] && sudo rm -rf "$VIGIL_POWER_HELPER_DIR"
    [[ -f "$VIGIL_ROOT_HELPER" ]] && sudo rm -f "$VIGIL_ROOT_HELPER"
    if [[ -d "$VIGIL_ROOT_BIN_DIR" ]]; then
        sudo rmdir "$VIGIL_ROOT_BIN_DIR" >/dev/null 2>&1 || true
    fi
    if [[ -d "$VIGIL_ROOT_DIR" ]]; then
        sudo rmdir "$VIGIL_ROOT_DIR" >/dev/null 2>&1 || true
    fi
}

cmd_lock_json_field() {
    local field="${1:?field required}"
    local json="${2:-}"
    printf '%s\n' "$json" | sed -nE "s/.*\"${field}\":(true|false).*/\\1/p"
}

cmd_lock_check_permissions_json() {
    local prompt="${1:-0}"
    local prompt_arg=""
    if (( prompt == 1 )); then
        prompt_arg="--prompt"
    fi
    if [[ -n "$prompt_arg" ]]; then
        "$VIGIL_LOCK_HELPER" --check-permissions --json "$prompt_arg"
    else
        "$VIGIL_LOCK_HELPER" --check-permissions --json
    fi
}

cmd_lock_require_helper() {
    if [[ "$VIGIL_LOCK_HELPER" == */ ]]; then
        echo "vigil lock: invalid helper path (trailing /): $VIGIL_LOCK_HELPER"
        return 1
    fi
    if [[ ! -f "$VIGIL_LOCK_HELPER" ]]; then
        echo "vigil lock: missing helper at $VIGIL_LOCK_HELPER"
        echo "  run: vigil setup (or vigil reload) to build and install vigil-lock-helper"
        return 1
    fi
    if [[ ! -x "$VIGIL_LOCK_HELPER" ]]; then
        echo "vigil lock: helper is not executable: $VIGIL_LOCK_HELPER"
        echo "  run: vigil setup (or vigil reload) to reinstall the helper"
        return 1
    fi
    return 0
}

cmd_provider_roots_json() {
    local sep="" agent home dir exists age age_json
    printf '{'
    for agent in claude codex copilot; do
        home=$(vigil_agent_home_for "$agent")
        dir=$(vigil_session_dir_for_agent "$agent")
        exists=false
        [[ -d "$dir" ]] && exists=true
        age=$(vigil_agent_latest_activity_age_secs "$agent" 2>/dev/null || true)
        if [[ "$age" =~ ^-?[0-9]+$ ]]; then
            age_json="$age"
        else
            age_json="null"
        fi
        printf '%s"%s":{"home":"%s","session_dir":"%s","exists":%s,"latest_activity_age_secs":%s}' \
            "$sep" "$agent" "$(vigil_json_escape "$home")" "$(vigil_json_escape "$dir")" "$exists" "$age_json"
        sep=","
    done
    printf '}'
}

cmd_provider_roots_text() {
    local agent home dir exists state
    for agent in claude codex copilot; do
        home=$(vigil_agent_home_for "$agent")
        dir=$(vigil_session_dir_for_agent "$agent")
        exists="no"
        [[ -d "$dir" ]] && exists="yes"
        state=$(vigil_agent_state "$agent")
        printf '  %-7s home=%s\n' "$agent" "$home"
        printf '          session=%s exists=%s state=%s\n' "$dir" "$exists" "$state"
    done
}

cmd_agent_states_line() {
    printf 'claude=%s  codex=%s  copilot=%s  vscode_copilot_chat=%s\n' \
        "$(vigil_agent_state claude)" "$(vigil_agent_state codex)" "$(vigil_agent_state copilot)" "$(vigil_vscode_copilot_chat_state)"
}

cmd_agent_state_from_flag() {
    local agent="$1" active="$2" dir
    dir=$(vigil_session_dir_for_agent "$agent") || { printf 'none\n'; return 0; }
    [[ -d "$dir" ]] || { printf 'none\n'; return 0; }
    if (( active == 1 )); then
        printf 'active\n'
    else
        printf 'idle\n'
    fi
}

cmd_vscode_state_from_flag() {
    local active="$1"
    if (( active == 1 )); then
        printf 'active\n'
    elif vigil_vscode_host_running; then
        printf 'idle\n'
    else
        printf 'none\n'
    fi
}

cmd_agent_states_line_from_flags() {
    local claude_active="$1" codex_active="$2" copilot_active="$3" vscode_copilot_active="$4"
    printf 'claude=%s  codex=%s  copilot=%s  vscode_copilot_chat=%s\n' \
        "$(cmd_agent_state_from_flag claude "$claude_active")" \
        "$(cmd_agent_state_from_flag codex "$codex_active")" \
        "$(cmd_agent_state_from_flag copilot "$copilot_active")" \
        "$(cmd_vscode_state_from_flag "$vscode_copilot_active")"
}

cmd_helper_launchd_status() {
    if launchctl print "system/$VIGIL_HELPER_LABEL" >/dev/null 2>&1; then
        printf 'loaded\n'
    else
        printf 'not loaded\n'
    fi
}

cmd_power_assertions_summary_line() {
    local assertions_out="$1"
    if [[ "$assertions_out" == "(none)" ]]; then
        printf 'none\n'
        return 0
    fi
    if [[ "$assertions_out" == "(parse-failed;"* ]]; then
        printf 'parse failed\n'
        return 0
    fi

    local total=0 vigil_total=0 marker
    while IFS=$'\t' read -r _pid _proc _atype marker; do
        [[ -z "${_pid:-}" ]] && continue
        total=$((total+1))
        [[ "${marker:-}" == *vigil* ]] && vigil_total=$((vigil_total+1))
    done <<< "$assertions_out"
    if (( total == 0 )); then
        printf 'none\n'
    elif (( vigil_total > 0 )); then
        printf '%s active (%s vigil)\n' "$total" "$vigil_total"
    else
        printf '%s active\n' "$total"
    fi
}

cmd_power_hold_summary_line() {
    local sd="$1" baseline="$2" caff_pid="$3"
    local caff_alive="no" hold="released"
    vigil_pmset_caffeinate_alive && caff_alive="yes"
    if vigil_pmset_hold_engaged; then
        hold="engaged"
    fi
    printf 'hold=%s  mode=%s  disablesleep=%s  baseline=%s  caffeinate=%s' "$hold" "$(vigil_pmset_active_mode)" "$sd" "$baseline" "$caff_alive"
    if [[ "$caff_pid" != "-" ]]; then
        printf ' pid=%s' "$caff_pid"
    fi
    printf '\n'
}

cmd_daemon_tick_field() {
    local field="$1"
    [[ -f "$VIGIL_DAEMON_TICK_FILE" ]] || return 1
    awk -F= -v k="$field" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$VIGIL_DAEMON_TICK_FILE"
}

cmd_daemon_scan_info() {
    local loaded="$1" daemon_pid="$2"
    if [[ "$loaded" != "yes" ]]; then
        printf 'unloaded\t-\tnot running\n'
        return 0
    fi
    if [[ ! "$daemon_pid" =~ ^[0-9]+$ ]]; then
        printf 'starting\t-\tstarting (pid pending)\n'
        return 0
    fi

    local tick_pid updated
    tick_pid=$(cmd_daemon_tick_field pid 2>/dev/null || true)
    updated=$(cmd_daemon_tick_field updated_at 2>/dev/null || true)
    if [[ "$tick_pid" != "$daemon_pid" || ! "$updated" =~ ^[0-9]+$ ]]; then
        local pid_mtime now pid_age wait_secs missing_after
        pid_mtime=$(stat -f %m "$VIGIL_DAEMON_PIDFILE" 2>/dev/null || echo 0)
        if [[ "$pid_mtime" =~ ^[0-9]+$ && "$pid_mtime" != "0" ]]; then
            now=$(vigil_now_unix)
            pid_age=$(( now - pid_mtime ))
            (( pid_age < 0 )) && pid_age=0
            wait_secs="${VIGIL_START_WAIT_SECS:-6}"
            case "$wait_secs" in ''|*[!0-9]*) wait_secs=6 ;; esac
            missing_after=$(( wait_secs + VIGIL_TICK_SECS + 3 ))
            (( missing_after < 10 )) && missing_after=10
            if (( pid_age > missing_after )); then
                printf 'missing\t-\tscan snapshot missing (run '\''vigil reload'\'')\n'
                return 0
            fi
        fi
        printf 'pending\t-\tpending first scan\n'
        return 0
    fi

    local now age tick_secs stale_after
    now=$(vigil_now_unix)
    age=$(( now - updated ))
    (( age < 0 )) && age=0
    tick_secs=$(cmd_daemon_tick_field tick_secs 2>/dev/null || true)
    [[ "$tick_secs" =~ ^[0-9]+$ ]] || tick_secs="$VIGIL_TICK_SECS"
    stale_after=$(( tick_secs * 2 + 5 ))
    (( stale_after < 15 )) && stale_after=15
    if (( age > stale_after )); then
        printf 'stale\t%s\tstale (%ss ago)\n' "$age" "$age"
    else
        printf 'fresh\t%s\t%ss ago\n' "$age" "$age"
    fi
}

cmd_live_active_match_count() {
    local claude_active="$1" codex_active="$2" copilot_active="$3" vscode_copilot_active="$4"
    local count=0 pid name exe args
    while IFS=$'\t' read -r pid name exe args; do
        [[ -z "${pid:-}" ]] && continue
        case "$name" in
            cli-claude)  (( claude_active ))  && count=$((count+1)) ;;
            cli-codex|app-codex) (( codex_active )) && count=$((count+1)) ;;
            cli-copilot) (( copilot_active )) && count=$((count+1)) ;;
            app-vscode-copilot-chat) (( vscode_copilot_active )) && count=$((count+1)) ;;
        esac
    done < <(vigil_detect_all 2>/dev/null || true)
    printf '%s\n' "$count"
}

cmd_wait_for_lock_power_hold() {
    local domain="gui/$(id -u)"
    launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1 || return 0

    local wait_secs="${VIGIL_START_WAIT_SECS:-6}"
    case "$wait_secs" in ''|*[!0-9]*) wait_secs=6 ;; esac
    local max_ticks=$(( wait_secs * 10 ))
    local i active engaged cut_thermal cut_battery cooling
    for i in $(seq 1 "$max_ticks"); do
        active=$(cmd_daemon_tick_field refcount_active 2>/dev/null || true)
        engaged=$(cmd_daemon_tick_field engaged 2>/dev/null || true)
        cut_thermal=$(cmd_daemon_tick_field thermal_cut 2>/dev/null || true)
        cut_battery=$(cmd_daemon_tick_field battery_cut 2>/dev/null || true)
        cooling=$(cmd_daemon_tick_field cooling 2>/dev/null || true)
        if [[ "$active" =~ ^[0-9]+$ ]] && (( active > 0 )); then
            if [[ "$engaged" == "1" || "$cut_thermal" == "1" || "$cut_battery" == "1" || "$cooling" == "1" ]]; then
                return 0
            fi
        fi
        sleep 0.1
    done
    return 0
}

cmd_setup_dry_run() {
    local verbose="${1:-0}"
    echo "vigil: setup dry run (no changes will be made)"
    echo
    echo "  user:"
    echo "    state dir:        $VIGIL_STATE_DIR"
    echo "    log dir:          $VIGIL_LOG_DIR"
    echo "    install dir:      $VIGIL_INSTALL_DIR"
    echo "    LaunchAgent:      $VIGIL_PLIST"
    echo
    echo "  root:"
    echo "    helper binary:    $VIGIL_ROOT_HELPER"
    echo "    LaunchDaemon:     $VIGIL_HELPER_PLIST"
    echo "    helper requests:  $VIGIL_POWER_REQUEST_DIR"
    echo "    helper responses: $VIGIL_POWER_RESPONSE_DIR"
    echo "    newsyslog:        $VIGIL_NEWSYSLOG_FILE"

    if (( verbose == 1 )); then
        echo
        echo "  newsyslog (preview):"
        cmd_render_newsyslog | sed 's/^/    /'

        echo
        echo "  LaunchAgent plist (preview):"
        cmd_render_plist | sed 's/^/    /'

        echo
        echo "  LaunchDaemon helper plist (preview):"
        cmd_render_helper_plist | sed 's/^/    /'
    else
        echo
        echo "  generated file previews: hidden (use --verbose to print plist/newsyslog contents)"
    fi

    echo
    echo "vigil: dry run complete. No files were installed and launchd was not changed."
}

cmd_status_json() {
    local domain="gui/$(id -u)"
    local loaded=false loaded_text="no"
    if launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1; then
        loaded=true
        loaded_text="yes"
    fi

    local daemon_pid="-"
    local daemon_pid_json="null"
    if [[ -f "$VIGIL_DAEMON_PIDFILE" ]]; then
        daemon_pid=$(cat "$VIGIL_DAEMON_PIDFILE" 2>/dev/null)
        [[ "$daemon_pid" =~ ^[0-9]+$ ]] && daemon_pid_json="$daemon_pid"
    fi
    local scan_state scan_age scan_text
    IFS=$'\t' read -r scan_state scan_age scan_text < <(cmd_daemon_scan_info "$loaded_text" "$daemon_pid")
    local scan_age_json="null"
    [[ "$scan_age" =~ ^[0-9]+$ ]] && scan_age_json="$scan_age"

    local claude_active=0;  vigil_agent_is_active claude  && claude_active=1
    local codex_active=0;   vigil_agent_is_active codex   && codex_active=1
    local copilot_active=0; vigil_agent_is_active copilot && copilot_active=1
    local vscode_copilot_active=0; vigil_vscode_copilot_chat_is_active && vscode_copilot_active=1
    local active; active=$(vigil_refcount_count "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active")
    local total; total=$(vigil_refcount_count_total)
    local pending_active_matches=0
    if (( active == 0 && (claude_active || codex_active || copilot_active || vscode_copilot_active) )) && [[ "$loaded_text" == "yes" ]]; then
        pending_active_matches=$(cmd_live_active_match_count "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active")
    fi
    local idle_min=$(( (VIGIL_IDLE_AFTER_SEC + 59) / 60 ))
    local sd; sd=$(vigil_read_sleepdisabled)
    local baseline_json="null"
    [[ -f "$VIGIL_BASELINE_FILE" ]] && baseline_json=$(vigil_pmset_baseline_value)
    local caff_json="null" caff_alive=false
    if [[ -f "$VIGIL_CAFFEINATE_PIDFILE" ]]; then
        local caff; caff=$(vigil_pmset_caffeinate_pid 2>/dev/null || true)
        [[ "$caff" =~ ^[0-9]+$ ]] && caff_json="$caff"
        vigil_pmset_caffeinate_alive && caff_alive=true
    fi
    local power_helper_ok=false
    vigil_power_helper_check && power_helper_ok=true

    local assertions_out; assertions_out=$(vigil_assertions_summary)
    local assertions_state="ok" assertions_json="" sep=""
    if [[ "$assertions_out" == "(none)" ]]; then
        assertions_state="none"
    elif [[ "$assertions_out" == "(parse-failed;"* ]]; then
        assertions_state="parse_failed"
    else
        local pid proc atype marker vigil_marker
        while IFS=$'\t' read -r pid proc atype marker; do
            [[ -z "${pid:-}" ]] && continue
            vigil_marker=false
            [[ "${marker:-}" == *vigil* ]] && vigil_marker=true
            assertions_json+="${sep}{\"pid\":$pid,\"process\":\"$(vigil_json_escape "$proc")\",\"type\":\"$(vigil_json_escape "$atype")\",\"vigil\":$vigil_marker}"
            sep=","
        done <<< "$assertions_out"
    fi

    printf '{\n'
    printf '  "launchd_loaded": %s,\n' "$loaded"
    printf '  "daemon_pid": %s,\n' "$daemon_pid_json"
    printf '  "daemon_scan_state": "%s",\n' "$(vigil_json_escape "$scan_state")"
    printf '  "daemon_scan_age_secs": %s,\n' "$scan_age_json"
    printf '  "refcount_active": %s,\n' "$active"
    printf '  "refcount_total": %s,\n' "$total"
    printf '  "pending_active_matches": %s,\n' "$pending_active_matches"
    printf '  "idle_window_minutes": %s,\n' "$idle_min"
    printf '  "agents": {"claude":"%s","codex":"%s","copilot":"%s","vscode_copilot_chat":"%s"},\n' \
        "$(vigil_agent_state claude)" "$(vigil_agent_state codex)" "$(vigil_agent_state copilot)" "$(vigil_vscode_copilot_chat_state)"
    printf '  "provider_roots": %s,\n' "$(cmd_provider_roots_json)"
    printf '  "power_hold_mode": "%s",\n' "$(vigil_json_escape "$(vigil_pmset_active_mode)")"
    printf '  "pmset_disablesleep": %s,\n' "$sd"
    printf '  "baseline": %s,\n' "$baseline_json"
    printf '  "caffeinate_pid": %s,\n' "$caff_json"
    printf '  "caffeinate_alive": %s,\n' "$caff_alive"
    printf '  "thermal": "%s",\n' "$(vigil_json_escape "$(vigil_thermal_summary)")"
    printf '  "battery": "%s",\n' "$(vigil_json_escape "$(vigil_battery_summary)")"
    printf '  "power_helper_ok": %s,\n' "$power_helper_ok"
    printf '  "power_assertions_state": "%s",\n' "$assertions_state"
    printf '  "power_assertions": [%s]\n' "$assertions_json"
    printf '}\n'
}

cmd_doctor_power() {
    local verbose="${1:-0}"
    local errs=0
    echo "vigil power doctor"
    echo
    local arch; arch=$(uname -m)
    printf '  cpu arch:           %s\n' "$arch"
    if [[ "$arch" == "arm64" ]]; then
        echo "                      Apple Silicon: closed-lid operation is best-effort unless clamshell requirements are met."
    fi
    if command -v pmset >/dev/null 2>&1; then
        printf '  pmset:              %s\n' "$(command -v pmset)"
    else
        printf '  pmset:              MISSING\n'
        errs=$((errs+1))
    fi
    if command -v caffeinate >/dev/null 2>&1; then
        printf '  caffeinate:         %s\n' "$(command -v caffeinate)"
    else
        printf '  caffeinate:         MISSING\n'
        errs=$((errs+1))
    fi
    printf '  power hold mode:    best-effort\n'
    printf '  display sleep:      allowed (pmset disablesleep + caffeinate -i, no -d)\n'
    printf '  pmset disablesleep: %s\n' "$(vigil_read_sleepdisabled)"
    local baseline="-"
    [[ -f "$VIGIL_BASELINE_FILE" ]] && baseline=$(vigil_pmset_baseline_value)
    printf '  baseline:           %s\n' "$baseline"
    local caff="-"
    [[ -f "$VIGIL_CAFFEINATE_PIDFILE" ]] && caff=$(vigil_pmset_caffeinate_pid 2>/dev/null || echo "-")
    printf '  caffeinate pid:     %s\n' "$caff"
    printf '  caffeinate alive:   %s\n' "$(vigil_pmset_caffeinate_alive && echo yes || echo no)"
    if vigil_power_helper_check; then
        printf '  root helper:        ok\n'
    else
        printf '  root helper:        FAIL\n'
        errs=$((errs+1))
    fi
    printf '  thermal:            %s\n' "$(vigil_thermal_summary)"
    printf '  battery:            %s\n' "$(vigil_battery_summary)"
    local assertions_out; assertions_out=$(vigil_assertions_summary)
    printf '  power assertions:   %s\n' "$(cmd_power_assertions_summary_line "$assertions_out")"
    if (( verbose == 1 )); then
        echo
        echo '  provider roots:'
        cmd_provider_roots_text | sed 's/^/  /'
        echo
        echo '  power assertions:'
        if [[ "$assertions_out" == '('* ]]; then
            printf '%s\n' "$assertions_out" | sed 's/^/    /'
        else
            printf '%s\n' "$assertions_out" | LC_ALL=C awk -F'\t' '
                NF == 0 { next }
                { printf "    pid=%-7s %-28s %-32s %s\n", $1, $2, $3, $4 }
            '
        fi
    else
        echo
        echo "  detail: use 'vigil doctor --power --verbose' for provider paths and assertion rows"
    fi

    echo
    if (( errs == 0 )); then
        echo "result: power path checks passed"
        return 0
    fi
    echo "result: $errs power path check(s) failed"
    echo "next:   vigil setup"
    return 1
}

# ---- subcommands -------------------------------------------------------------

cmd_setup() {
    local dry_run=0 verbose=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --verbose) verbose=1; shift ;;
            *) die "usage: vigil setup [--dry-run] [--verbose]" ;;
        esac
    done
    if (( dry_run == 1 )); then
        cmd_setup_dry_run "$verbose"
        return 0
    fi

    cmd_require_admin_allowed
    cmd_assert_standard_privileged_paths
    cmd_assert_vigil_tree_path "install dir" "$VIGIL_INSTALL_DIR"

    echo "vigil: setting up"

    echo
    echo "  1. preparing user directories"
    vigil_ensure_dirs
    echo "     state dir: $VIGIL_STATE_DIR"
    echo "     log dir:   $VIGIL_LOG_DIR"

    # If a previous daemon is loaded, boot it out before we replace its binary.
    cmd_stop >/dev/null 2>&1 || true

    # 0. Sync daemon + libs into the install dir (must not be ~/Documents/).
    echo
    echo "  2. installing user daemon"
    cmd_sync_install

    # 1. Privileged helper LaunchDaemon. Runtime pmset transitions go through
    # this helper instead of repeated sudo from the user daemon.
    echo
    echo "  3. installing privileged power helper"
    if (( verbose == 1 )); then
        echo "     LaunchDaemon plist preview:"
        cmd_render_helper_plist | sed 's/^/       /'
        echo
    else
        echo "     LaunchDaemon: $VIGIL_HELPER_PLIST"
        echo "     binary:       $VIGIL_ROOT_HELPER"
    fi
    cmd_install_root_helper
    if [[ -f "$VIGIL_LEGACY_SUDOERS_FILE" ]]; then
        echo "  removing legacy sudoers file: $VIGIL_LEGACY_SUDOERS_FILE"
        sudo rm -f "$VIGIL_LEGACY_SUDOERS_FILE"
    fi

    # 2. newsyslog.d entry — same sudo session as helper install if the cached
    # credential is still valid; otherwise prompts a second time.
    local tmp_newsyslog; tmp_newsyslog=$(mktemp -t vigil-newsyslog)
    cmd_render_newsyslog > "$tmp_newsyslog"
    chmod 0644 "$tmp_newsyslog"
    echo
    echo "  4. installing log rotation"
    if (( verbose == 1 )); then
        echo "     newsyslog preview:"
        sed 's/^/       /' "$tmp_newsyslog"
    else
        echo "     newsyslog: $VIGIL_NEWSYSLOG_FILE"
    fi
    sudo install -m 0644 -o root -g wheel "$tmp_newsyslog" "$VIGIL_NEWSYSLOG_FILE"
    rm -f "$tmp_newsyslog"
    echo "  newsyslog: installed"

    # 3. LaunchAgent plist
    echo
    echo "  5. loading user LaunchAgent"
    mkdir -p "$(dirname "$VIGIL_PLIST")"
    cmd_render_plist > "$VIGIL_PLIST"
    echo "     plist: $VIGIL_PLIST"

    # 4. Bootstrap the LaunchAgent
    cmd_start

    echo
    echo "vigil: setup complete"
    echo "  next: vigil status"
}

cmd_uninstall() {
    [[ $# -eq 0 ]] || die "usage: vigil uninstall"
    cmd_require_admin_allowed
    cmd_assert_standard_privileged_paths
    cmd_assert_vigil_tree_path "install dir" "$VIGIL_INSTALL_DIR"

    echo "vigil: uninstalling"

    # Stop the daemon if it's running so it can release its hold cleanly.
    echo
    echo "  1. stopping user LaunchAgent"
    cmd_stop || true

    # Release any best-effort pmset/caffeinate hold before removing installed files.
    echo
    echo "  2. releasing power hold"
    vigil_pmset_release >/dev/null 2>&1 || true
    echo "     power hold: released if active"

    # Remove plist
    echo
    echo "  3. removing user LaunchAgent"
    if [[ -f "$VIGIL_PLIST" ]]; then
        rm -f "$VIGIL_PLIST"
        echo "     removed: $VIGIL_PLIST"
    else
        echo "     already absent: $VIGIL_PLIST"
    fi

    # Remove root-owned files — needs sudo.
    echo
    echo "  4. removing privileged helper and log rotation"
    if [[ -f "$VIGIL_NEWSYSLOG_FILE" || -f "$VIGIL_LEGACY_SUDOERS_FILE" || -f "$VIGIL_HELPER_PLIST" || -d "$VIGIL_POWER_HELPER_DIR" || -f "$VIGIL_ROOT_HELPER" ]]; then
        [[ -f "$VIGIL_NEWSYSLOG_FILE" ]] && { echo "     removing newsyslog: $VIGIL_NEWSYSLOG_FILE (sudo may prompt)"; sudo rm -f "$VIGIL_NEWSYSLOG_FILE"; }
        [[ -f "$VIGIL_LEGACY_SUDOERS_FILE" ]] && { echo "     removing legacy sudoers: $VIGIL_LEGACY_SUDOERS_FILE"; sudo rm -f "$VIGIL_LEGACY_SUDOERS_FILE"; }
        if [[ -f "$VIGIL_HELPER_PLIST" || -d "$VIGIL_POWER_HELPER_DIR" || -f "$VIGIL_ROOT_HELPER" ]]; then
            cmd_remove_root_helper
        fi
    else
        echo "     no root-owned Vigil files found"
    fi

    # Restore baseline if any (e.g., daemon crashed mid-engagement)
    echo
    echo "  5. clearing local state"
    if [[ -f "$VIGIL_BASELINE_FILE" ]]; then
        rm -f "$VIGIL_BASELINE_FILE"
        echo "     baseline state: removed"
    else
        echo "     baseline state: already clear"
    fi

    # Wipe state + installed daemon copy. Keep logs (handy for post-mortem).
    if [[ -d "$VIGIL_INSTALL_DIR" ]]; then
        rm -rf "$VIGIL_INSTALL_DIR"
        echo "     install dir: removed $VIGIL_INSTALL_DIR"
    else
        echo "     install dir: already absent $VIGIL_INSTALL_DIR"
    fi

    echo
    echo "vigil: uninstall complete"
    echo "  logs preserved: $VIGIL_LOG_DIR"
}

cmd_start() {
    if [[ ! -f "$VIGIL_PLIST" ]]; then
        die "plist not found at $VIGIL_PLIST — run 'vigil setup' first"
    fi
    local domain="gui/$(id -u)"
    if launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1; then
        echo "  launchd: already loaded ($domain/$VIGIL_LABEL)"
        return 0
    fi
    launchctl bootstrap "$domain" "$VIGIL_PLIST"
    launchctl enable "$domain/$VIGIL_LABEL" 2>/dev/null || true
    echo "  launchd: bootstrapped $VIGIL_LABEL"
    cmd_wait_for_daemon_scan "$domain" || true
}

cmd_stop() {
    local domain="gui/$(id -u)"
    if launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1; then
        launchctl bootout "$domain/$VIGIL_LABEL" 2>/dev/null || true
        # Poll until launchd has fully torn the service down. `bootout` returns
        # quickly but deregistration can briefly outlast the call; a follow-up
        # `bootstrap` against the half-torn-down state yields:
        #     Bootstrap failed: 5: Input/output error
        # Without this poll, `vigil setup` (which calls cmd_stop then later
        # cmd_start) intermittently leaves the new service unloaded — the
        # bootstrap "succeeds" but launchd promptly drops the registration.
        # Bounded at 5s (50 × 100ms); in practice unloads complete in 1-2 ticks.
        local i
        for i in $(seq 1 50); do
            launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1 || break
            sleep 0.1
        done
        rm -f "$VIGIL_DAEMON_TICK_FILE"
        echo "  launchd: booted out $VIGIL_LABEL"
    else
        rm -f "$VIGIL_DAEMON_TICK_FILE" 2>/dev/null || true
        echo "  launchd: not loaded"
    fi
}

cmd_wait_for_daemon_scan() {
    local domain="$1"
    local wait_secs="${VIGIL_START_WAIT_SECS:-6}"
    case "$wait_secs" in ''|*[!0-9]*) wait_secs=6 ;; esac
    (( wait_secs < 1 )) && return 0

    local max_ticks=$(( wait_secs * 10 ))
    local i daemon_pid scan_state scan_age scan_text
    for i in $(seq 1 "$max_ticks"); do
        daemon_pid="-"
        [[ -f "$VIGIL_DAEMON_PIDFILE" ]] && daemon_pid=$(cat "$VIGIL_DAEMON_PIDFILE" 2>/dev/null)
        IFS=$'\t' read -r scan_state scan_age scan_text < <(cmd_daemon_scan_info "yes" "$daemon_pid")
        if [[ "$scan_state" == "fresh" ]]; then
            echo "  daemon scan: ready ($scan_text)"
            return 0
        fi
        if ! launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1; then
            echo "  daemon scan: service not running"
            return 1
        fi
        sleep 0.1
    done

    echo "  daemon scan: pending (run 'vigil status' for details)"
    return 0
}

cmd_status() {
    local verbose=0
    case "${1:-}" in
        --json)
            shift
            [[ $# -eq 0 ]] || die "usage: vigil status [--json]"
            cmd_status_json
            return 0
            ;;
        --verbose)
            verbose=1
            shift
            ;;
        "")
            ;;
        *)
            die "usage: vigil status [--json|--verbose]"
            ;;
    esac
    [[ $# -eq 0 ]] || die "usage: vigil status [--json|--verbose]"

    local domain="gui/$(id -u)"
    local loaded="no"
    launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1 && loaded="yes"

    local daemon_pid="-"
    [[ -f "$VIGIL_DAEMON_PIDFILE" ]] && daemon_pid=$(cat "$VIGIL_DAEMON_PIDFILE" 2>/dev/null)
    local scan_state scan_age scan_text
    IFS=$'\t' read -r scan_state scan_age scan_text < <(cmd_daemon_scan_info "$loaded" "$daemon_pid")

    # Per-agent activity, computed once for both the count and the per-row state.
    local claude_active=0;  vigil_agent_is_active claude  && claude_active=1
    local codex_active=0;   vigil_agent_is_active codex   && codex_active=1
    local copilot_active=0; vigil_agent_is_active copilot && copilot_active=1
    local vscode_copilot_active=0; vigil_vscode_copilot_chat_is_active && vscode_copilot_active=1

    local active; active=$(vigil_refcount_count "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active")
    local total;  total=$(vigil_refcount_count_total)
    local pending_active_matches=0
    if (( active == 0 && (claude_active || codex_active || copilot_active || vscode_copilot_active) )) && [[ "$loaded" == "yes" ]]; then
        pending_active_matches=$(cmd_live_active_match_count "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active")
    fi
    local idle_min=$(( (VIGIL_IDLE_AFTER_SEC + 59) / 60 ))
    local sd; sd=$(vigil_read_sleepdisabled)
    local baseline="-"
    [[ -f "$VIGIL_BASELINE_FILE" ]] && baseline=$(vigil_pmset_baseline_value)
    local caff="-"
    [[ -f "$VIGIL_CAFFEINATE_PIDFILE" ]] && caff=$(vigil_pmset_caffeinate_pid 2>/dev/null || echo "-")

    local helper_status; helper_status=$(cmd_helper_launchd_status)
    local assertions_out; assertions_out=$(vigil_assertions_summary)
    local hold_engaged=0
    if [[ "$sd" == "1" ]] || vigil_pmset_caffeinate_alive; then
        hold_engaged=1
    fi
    local cut_thermal=0 cut_battery=0
    vigil_thermal_should_cut && cut_thermal=1 || true
    vigil_battery_should_cut && cut_battery=1 || true
    local expected_hold=""
    if (( (active > 0 || pending_active_matches > 0) && hold_engaged == 0 )); then
        if (( cut_thermal == 1 )); then
            expected_hold="blocked by thermal cutoff"
        elif (( cut_battery == 1 )); then
            expected_hold="blocked by battery floor"
        elif [[ "$loaded" != "yes" ]]; then
            expected_hold="pending (LaunchAgent is not loaded)"
        elif [[ "$scan_state" == "starting" || "$scan_state" == "pending" ]]; then
            expected_hold="pending (daemon first scan has not completed)"
        elif [[ "$scan_state" == "stale" || "$scan_state" == "missing" ]]; then
            expected_hold="pending (daemon scan is unavailable; try 'vigil reload')"
        elif (( pending_active_matches > 0 )); then
            expected_hold="pending (live matches are waiting for the next daemon scan)"
        else
            expected_hold="pending (daemon/helper transition in progress)"
        fi
    fi

    echo "vigil status"
    echo
    echo "  service"
    printf '    launchd:      %s\n' "$loaded"
    printf '    daemon pid:    %s\n' "$daemon_pid"
    printf '    scan:          %s\n' "$scan_text"
    printf '    root helper:   %s\n' "$helper_status"
    echo
    echo "  activity"
    printf '    refcount:      %s active / %s total (idle window %sm)\n' "$active" "$total" "$idle_min"
    printf '    agents:        %s\n' "$(cmd_agent_states_line_from_flags "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active")"
    if (( pending_active_matches > 0 )); then
        printf '    pending scan:  %s live match(es) not counted yet\n' "$pending_active_matches"
    fi
    if (( total > 0 )); then
        echo "    tracked matches:"
        vigil_refcount_list "$claude_active" "$codex_active" "$copilot_active" "$vscode_copilot_active" \
            | awk -F'\t' '{printf "      pid=%-7s name=%-15s age=%-5s %s\n", $1, $2, $3"s", $4}'
    fi
    echo
    echo "  power"
    printf '    %s\n' "$(cmd_power_hold_summary_line "$sd" "$baseline" "$caff")"
    if [[ -n "$expected_hold" ]]; then
        printf '    expected hold: %s\n' "$expected_hold"
    fi
    printf '    thermal:       %s\n' "$(vigil_thermal_summary)"
    printf '    battery:       %s\n' "$(vigil_battery_summary)"
    printf '    assertions:    %s\n' "$(cmd_power_assertions_summary_line "$assertions_out")"

    if (( verbose == 1 )); then
        echo
        echo '  provider roots:'
        cmd_provider_roots_text | sed 's/^/    /'
        echo
        echo '  power assertions:'
        # vigil_assertions_summary emits either:
        #   - a literal "(none)" or "(parse-failed; raw output:)..." block, OR
        #   - one or more TSV rows: <pid>\t<process>\t<atype>[\t← vigil]
        # The first-char `(` is the discriminator. Tab-delimited rows get formatted;
        # parens-bracketed status passes through unchanged.
        if [[ "$assertions_out" == '('* ]]; then
            printf '%s\n' "$assertions_out" | sed 's/^/    /'
        else
            # LC_ALL=C — see the note in vigil_assertions_summary; we never touch
            # the assertion-name strings here (just pid/process/atype which are
            # ASCII-only) but the safety belt costs nothing.
            printf '%s\n' "$assertions_out" | LC_ALL=C awk -F'\t' '
                NF == 0 { next }
                { printf "    pid=%-7s %-28s %-32s %s\n", $1, $2, $3, $4 }
            '
        fi
    else
        echo
        echo "  detail: use 'vigil status --verbose' for provider paths and assertion rows"
    fi
}

cmd_log() {
    local follow=0
    [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]] && follow=1
    if [[ ! -f "$VIGIL_LOG_FILE" ]]; then
        echo "no log yet at $VIGIL_LOG_FILE"
        return 0
    fi
    if (( follow == 1 )); then
        tail -f "$VIGIL_LOG_FILE"
    else
        cat "$VIGIL_LOG_FILE"
    fi
}

cmd_run() {
    if [[ $# -eq 0 ]]; then
        die "usage: vigil run <cmd> [args...]"
    fi
    vigil_ensure_dirs

    # quoted-args summary; not robust to embedded newlines but fine for status display.
    local cmd_str="$*"
    vigil_refcount_touch_wrapper "$$" "$cmd_str"
    local pidfile="$VIGIL_ACTIVE_DIR/wrapper-$$.pid"

    # Bake $pidfile into the trap string so it survives the local scope ending.
    # If we used a function or unquoted variable here, set -u trips when the
    # trap fires after cmd_run has returned and `local pidfile` is gone.
    # shellcheck disable=SC2064
    trap "rm -f '$pidfile'" EXIT INT TERM HUP

    # Foreground call — bash blocks here. NOT exec; that would replace the shell
    # and prevent the trap from firing.
    "$@"
}

cmd_lock() {
    if [[ "$(uname -s)" != "Darwin" ]]; then
        echo "vigil lock: phase-4 local lock guard is macOS-only (not yet in phase 5 scope)."
        return 64
    fi

    case "${1:-}" in
        doctor)
            shift
            cmd_lock_doctor "$@"
            return $?
            ;;
        --help|-h|help)
            echo "Usage:"
            echo "  vigil lock [--combo <combo>] [--max-secs <seconds>]"
            echo "  vigil lock doctor [--prompt]"
            echo
            echo "  --combo <combo>     Unlock combo (default: $VIGIL_LOCK_COMBO)"
            echo "  --max-secs <secs>   Auto-stop timeout in seconds (0 = no timeout)"
            echo
            echo "  doctor              Run a permission and accessibility probe"
            echo "  doctor --prompt      Show permission prompts if not yet granted"
            return 0
            ;;
        "")
            ;;
        *)
            if [[ "${1:-}" == --* ]]; then
                :
            else
                echo "vigil lock: unknown subcommand: $1"
                echo "  run: vigil lock --help"
                return 64
            fi
            ;;
    esac

    local combo="$VIGIL_LOCK_COMBO"
    local max_secs="$VIGIL_LOCK_MAX_SECS"
    local saw_max=0
    local arg
    while [[ $# -gt 0 ]]; do
        arg="$1"
        case "$arg" in
            --combo)
                shift
                [[ $# -ge 1 ]] || die "usage: vigil lock [--combo <combo>] [--max-secs <seconds>]"
                combo="$1"
                shift
                ;;
            --max-secs)
                shift
                [[ $# -ge 1 ]] || die "usage: vigil lock [--combo <combo>] [--max-secs <seconds>]"
                if [[ "$1" == *[!0-9]* ]]; then
                    die "max seconds must be a non-negative integer"
                fi
                max_secs="$1"
                saw_max=1
                shift
                ;;
            *)
                die "usage: vigil lock [--combo <combo>] [--max-secs <seconds>]"
                ;;
        esac
    done

    if [[ "$max_secs" == "0" && $saw_max -eq 0 ]]; then
        echo "vigil lock: VIGIL_LOCK_MAX_SECS=0 is only accepted when passed explicitly via --max-secs."
        echo "  set --max-secs 0 to enable a no-timeout run, or use a non-zero default in vigil.conf."
        return 1
    fi

    cmd_lock_require_helper || return 1

    local json
    if ! json=$(cmd_lock_check_permissions_json 0); then
        :
    fi
    if [[ -z "${json:-}" ]]; then
        echo "vigil lock: preflight doctor failed; helper did not run permission probe."
        echo "  run: vigil lock doctor for details"
        return 1
    fi
    local listen access tap
    listen="$(cmd_lock_json_field "listen_event_access" "$json")"
    access="$(cmd_lock_json_field "accessibility_trusted" "$json")"
    tap="$(cmd_lock_json_field "tap_create_active_hid_ok" "$json")"
    if [[ -z "$listen" || -z "$access" || -z "$tap" ]]; then
        echo "vigil lock: failed to parse permission JSON"
        echo "  raw: $json"
        return 1
    fi
    if [[ "$listen" != "true" || "$access" != "true" || "$tap" != "true" ]]; then
        echo "vigil lock: doctor preflight failed; run this first:"
        echo "  vigil lock doctor"
        return 1
    fi

    vigil_ensure_dirs
    vigil_refcount_touch_wrapper "$$" "vigil lock"
    local lock_pidfile="$VIGIL_ACTIVE_DIR/wrapper-$$.pid"
    # shellcheck disable=SC2064
    trap "rm -f '$lock_pidfile'" EXIT INT TERM HUP
    cmd_wait_for_lock_power_hold

    echo "  lock combo:  $combo"
    echo "  max seconds: ${max_secs} (0 = no timeout)"
    echo "  helper:      $VIGIL_LOCK_HELPER"
    echo "  sleep hold:  best effort; display sleep and macOS Lock Screen are allowed"
    echo "  recover:     pkill -TERM vigil-lock-helper"
    echo "  This is a local freeze guard, not the macOS Lock Screen."
    echo "  If macOS locks first, login input is allowed; the combo is still required after login."
    for delay in 3 2 1; do
        printf '  starting in %ss...\n' "$delay"
        sleep 1
    done

    "$VIGIL_LOCK_HELPER" --freeze --combo "$combo" --max-secs "$max_secs"
}

cmd_lock_doctor() {
    if [[ "$(uname -s)" != "Darwin" ]]; then
        echo "vigil lock doctor: phase-4 lock guard is macOS-only."
        return 64
    fi
    if ! cmd_lock_require_helper; then
        return 1
    fi

    local prompt=0
    case "${1:-}" in
        --prompt)
            prompt=1
            shift
            ;;
        "")
            ;;
        *)
            die "usage: vigil lock doctor [--prompt]"
            ;;
    esac
    [[ $# -eq 0 ]] || die "usage: vigil lock doctor [--prompt]"

    local json
    if ! json=$(cmd_lock_check_permissions_json "$prompt"); then
        :
    fi
    if [[ -z "${json:-}" ]]; then
        echo "vigil lock doctor: failed to run helper permission probe"
        return 1
    fi

    local listen access post_event tap
    listen=$(cmd_lock_json_field "listen_event_access" "$json")
    access=$(cmd_lock_json_field "accessibility_trusted" "$json")
    post_event=$(cmd_lock_json_field "post_event_access" "$json")
    tap=$(cmd_lock_json_field "tap_create_active_hid_ok" "$json")

    if [[ -z "$listen" || -z "$access" || -z "$post_event" || -z "$tap" ]]; then
        echo "vigil lock doctor: failed to parse permission JSON"
        echo "  raw: $json"
        return 1
    fi

    echo "vigil lock doctor"
    echo "  listen_event_access:       $listen"
    echo "  accessibility_trusted:     $access"
    echo "  post_event_access:         $post_event (informational)"
    echo "  tap_create_active_hid_ok:    $tap"
    echo "  helper: $VIGIL_LOCK_HELPER"
    echo
    echo "System Settings > Privacy & Security > Input Monitoring"
    echo "System Settings > Privacy & Security > Accessibility"
    echo

    if (( prompt == 1 )); then
        echo "Prompts/permission changes are asynchronous on macOS."
        echo "Run this doctor command again after granting access."
    fi

    if [[ "$listen" == "true" && "$access" == "true" && "$tap" == "true" ]]; then
        echo "lock guard readiness: ready"
        return 0
    fi
    echo "lock guard readiness: not ready"
    return 1
}

cmd_reload() {
    # Re-sync daemon + libs from source repo into install dir, then bounce launchd
    # via cmd_stop (bootout+poll) + cmd_start (bootstrap).
    #
    # Why NOT `launchctl kickstart -k`: kickstart restarts the daemon process
    # but launchd KEEPS the cached plist config in memory. So plist changes —
    # ExitTimeOut, ThrottleInterval, EnvironmentVariables, RunAtLoad, etc. —
    # never take effect on the live service. `vigil reload` is the user-facing
    # mechanism for picking up plist changes, so it must re-read the plist.
    cmd_sync_install
    if [[ -f "$VIGIL_PLIST" ]]; then
        cmd_render_plist > "$VIGIL_PLIST"
        echo "  re-rendered $VIGIL_PLIST"
    fi
    cmd_stop
    cmd_start
    echo "vigil: reload complete."
}

cmd_doctor() {
    local power=0 verbose=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --power) power=1; shift ;;
            --verbose) verbose=1; shift ;;
            *) die "usage: vigil doctor [--power] [--verbose]" ;;
        esac
    done
    if (( power == 1 )); then
        if cmd_doctor_power "$verbose"; then
            return 0
        fi
        return 1
    fi

    local errs=0 warns=0 install_markers=0
    echo "vigil doctor"
    echo

    echo "  platform"
    local arch; arch=$(uname -m)
    printf '    cpu arch:      %s\n' "$arch"
    if [[ "$arch" == "arm64" ]]; then
        echo "    note:          Apple Silicon closed-lid sleep prevention is best-effort"
        echo "                   See docs/apple-silicon-lid-closed.md"
    fi

    echo
    echo "  dependencies"
    if command -v caffeinate >/dev/null 2>&1; then
        printf '    caffeinate:    ok\n'
    else
        printf '    caffeinate:    missing (expected /usr/bin/caffeinate)\n'
        errs=$((errs+1))
    fi
    if command -v pmset >/dev/null 2>&1; then
        printf '    pmset:         ok\n'
    else
        printf '    pmset:         missing\n'
        errs=$((errs+1))
    fi

    echo
    echo "  privileged helper"
    printf '    power mode:    best-effort\n'
    if [[ -x "$VIGIL_ROOT_HELPER" ]]; then
        printf '    binary:        ok\n'
    else
        printf '    binary:        missing (run vigil setup)\n'
        errs=$((errs+1))
    fi
    if [[ -f "$VIGIL_HELPER_PLIST" ]]; then
        printf '    LaunchDaemon:  ok\n'
    else
        printf '    LaunchDaemon:  missing (run vigil setup)\n'
        errs=$((errs+1))
    fi
    if vigil_power_helper_check; then
        printf '    IPC:           ok\n'
    else
        printf '    IPC:           fail (helper unavailable)\n'
        errs=$((errs+1))
    fi
    if [[ -f "$VIGIL_NEWSYSLOG_FILE" ]]; then
        printf '    log rotation:  ok\n'
    else
        printf '    log rotation:  missing (run vigil setup)\n'
        errs=$((errs+1))
    fi

    echo
    echo "  user agent"
    if [[ -f "$VIGIL_PLIST" ]]; then
        install_markers=$((install_markers+1))
        printf '    LaunchAgent:   ok\n'
    else
        printf '    LaunchAgent:   missing (run vigil setup)\n'
        errs=$((errs+1))
    fi
    if [[ -x "$VIGIL_INSTALL_DIR/bin/vigil-daemon" ]]; then
        install_markers=$((install_markers+1))
        printf '    daemon:        ok\n'
    else
        printf '    daemon:        missing (run vigil setup)\n'
        errs=$((errs+1))
    fi
    if [[ -x "$VIGIL_INSTALL_DIR/bin/vigil-lock-helper" ]]; then
        printf '    lock helper:   ok\n'
    else
        printf '    lock helper:   missing (run vigil setup/reload before using vigil lock)\n'
        warns=$((warns+1))
    fi

    local domain="gui/$(id -u)"
    if launchctl print "$domain/$VIGIL_LABEL" >/dev/null 2>&1; then
        printf '    launchd:       loaded\n'
    else
        printf '    launchd:       not loaded (run vigil start if intentionally stopped)\n'
    fi

    if [[ -d "$VIGIL_STATE_DIR" ]]; then
        install_markers=$((install_markers+1))
        local mode; mode=$(stat -f %Lp "$VIGIL_STATE_DIR" 2>/dev/null)
        printf '    state dir:     ok (mode %s)\n' "$mode"
    else
        printf '    state dir:     missing\n'
        errs=$((errs+1))
    fi
    if [[ -d "$VIGIL_LOG_DIR" ]]; then
        printf '    log dir:       ok\n'
    else
        printf '    log dir:       missing\n'
        errs=$((errs+1))
    fi

    echo
    echo "  providers"
    printf '    agents:        %s\n' "$(cmd_agent_states_line)"

    if (( verbose == 1 )); then
        echo
        echo "  paths"
        printf '    root helper:   %s\n' "$VIGIL_ROOT_HELPER"
        printf '    LaunchDaemon:  %s\n' "$VIGIL_HELPER_PLIST"
        printf '    newsyslog:     %s\n' "$VIGIL_NEWSYSLOG_FILE"
        printf '    LaunchAgent:   %s\n' "$VIGIL_PLIST"
        printf '    install dir:   %s\n' "$VIGIL_INSTALL_DIR"
        printf '    state dir:     %s\n' "$VIGIL_STATE_DIR"
        printf '    log dir:       %s\n' "$VIGIL_LOG_DIR"

        echo
        echo '  provider roots:'
        cmd_provider_roots_text | sed 's/^/    /'
    else
        echo
        echo "  detail: use 'vigil doctor --verbose' for install paths and provider roots"
    fi

    echo
    local doctor_state="not installed"
    if (( errs == 0 )); then
        if (( warns > 0 )); then
            doctor_state="ready with warnings"
        else
            doctor_state="ready"
        fi
    elif (( install_markers > 0 )); then
        doctor_state="needs repair"
    fi
    printf 'state:  %s\n' "$doctor_state"
    if (( errs == 0 )); then
        if (( warns > 0 )); then
            echo "result: required checks passed with $warns warning(s)"
        else
            echo "result: all checks passed"
        fi
        echo "next:   vigil status"
    elif [[ "$doctor_state" == "not installed" ]]; then
        echo "result: setup required ($errs required check(s) missing)"
        echo "next:   vigil setup"
        return 1
    else
        echo "result: $errs required check(s) failed"
        echo "next:   vigil setup"
        return 1
    fi
}

cmd_help() {
    cat <<EOF
vigil — keep Mac awake while AI agents are working

Usage:
  vigil setup        Install root helper + newsyslog entry, create state/log dirs, load LaunchAgent
  vigil setup --dry-run [--verbose]
                     Preview install plan without changing the system
  vigil setup --verbose
                     Print generated plist/newsyslog previews during setup
  vigil uninstall    Remove helper + newsyslog entry, plist, restore baseline state, wipe state
  vigil start        Bootstrap the LaunchAgent
  vigil stop         Boot out the LaunchAgent
  vigil status       Show service, activity, and power state
  vigil status --verbose
                     Include provider paths and raw power assertion rows
  vigil status --json
                     Print machine-readable daemon and power state
  vigil log [-f]     cat / tail -f the daemon log
  vigil run <cmd>    Wrapper: holds sleep prevention while <cmd> runs
  vigil reload       Re-sync daemon + libs into install dir, restart launchd
  vigil lock         Freeze input until configured combo, then continue
  vigil lock --help  Show lock mode usage
  vigil lock doctor  Run macOS permission smoke test for the lock helper
  vigil doctor [--verbose]
                     Diagnose installation
  vigil doctor --power [--verbose]
                     Focused power-path diagnostics and assertion summary
  vigil --version    Print version
  vigil --help       Show this help

Phase 1 detects the CLI processes 'claude', 'codex', 'copilot' only.
Desktop apps and copilot-companion daemon are deferred — see ROADMAP.md.

Lid-closed on Apple Silicon: see docs/apple-silicon-lid-closed.md.
EOF
}

# ---- dispatch ----------------------------------------------------------------

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        setup)            cmd_setup "$@" ;;
        uninstall)        cmd_uninstall "$@" ;;
        start)            cmd_start "$@" ;;
        stop)             cmd_stop "$@" ;;
        status)           cmd_status "$@" ;;
        log)              cmd_log "$@" ;;
        run)              cmd_run "$@" ;;
        reload)           cmd_reload "$@" ;;
        lock)             cmd_lock "$@" ;;
        doctor)           cmd_doctor "$@" ;;
        --version|-V)     printf 'vigil %s\n' "$VIGIL_VERSION" ;;
        --help|-h|help)   cmd_help ;;
        *)
            printf 'vigil: unknown command: %s\n\n' "$cmd" >&2
            cmd_help >&2
            exit 64
            ;;
    esac
}

main "$@"
