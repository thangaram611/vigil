#!/bin/bash
# bin/vigil-root-helper - privileged pmset transition helper.
#
# This script is installed as root and run by launchd as
# com.thangaram.vigil.helper. It accepts only request files containing one of:
#   engage, release, status
# and runs fixed /usr/bin/pmset argv for power-setting changes.

set -euo pipefail

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

HELPER_REQUEST_DIR=""
HELPER_RESPONSE_DIR=""
HELPER_STATE_DIR=""
HELPER_LOG_FILE=""
HELPER_ALLOWED_UID=""
HELPER_ALLOWED_USER=""
HELPER_POLL_SECS="1"
HELPER_ONCE=0

helper_usage() {
    cat >&2 <<'EOF'
usage: vigil-root-helper --serve --request-dir DIR --response-dir DIR --state-dir DIR --log-file FILE --allowed-uid UID --allowed-user USER
       vigil-root-helper --once  --request-dir DIR --response-dir DIR --state-dir DIR --log-file FILE --allowed-uid UID --allowed-user USER
EOF
}

helper_log() {
    local level="$1"; shift
    local ts; ts=$(date '+%Y-%m-%dT%H:%M:%S%z')
    mkdir -p "$(dirname "$HELPER_LOG_FILE")" 2>/dev/null || true
    printf '%s %s %s\n' "$ts" "$level" "$*" >> "$HELPER_LOG_FILE" 2>/dev/null || true
}

helper_die() {
    helper_log ERROR "$*"
    printf 'vigil-root-helper: %s\n' "$*" >&2
    exit 1
}

helper_stat_uid() {
    stat -f '%u' "$1" 2>/dev/null || stat -c '%u' "$1"
}

helper_stat_mode() {
    stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1"
}

helper_stat_nlink() {
    stat -f '%l' "$1" 2>/dev/null || stat -c '%h' "$1"
}

helper_mode_group_or_other_writable() {
    local mode="$1" group_digit other_digit
    group_digit="${mode: -2:1}"
    other_digit="${mode: -1:1}"
    [[ "$group_digit" =~ ^[0-7]$ && "$other_digit" =~ ^[0-7]$ ]] || return 0
    (( (10#$group_digit & 2) != 0 || (10#$other_digit & 2) != 0 ))
}

helper_pmset() {
    /usr/bin/pmset "$@"
}

helper_read_sleepdisabled() {
    local out
    out=$(helper_pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $NF}')
    case "$out" in
        0|1) printf '%s\n' "$out" ;;
        *) printf '0\n' ;;
    esac
}

helper_baseline_file() {
    printf '%s/baseline' "$HELPER_STATE_DIR"
}

helper_engaged_file() {
    printf '%s/engaged' "$HELPER_STATE_DIR"
}

helper_is_engaged() {
    [[ -f "$(helper_engaged_file)" ]]
}

helper_mark_engaged() {
    printf '1\n' > "$(helper_engaged_file)"
    chmod 0600 "$(helper_engaged_file)" 2>/dev/null || true
}

helper_mark_released() {
    rm -f "$(helper_engaged_file)"
}

helper_current_baseline() {
    local file; file=$(helper_baseline_file)
    if [[ -f "$file" ]]; then
        local value; value=$(cat "$file" 2>/dev/null || true)
        case "$value" in 0|1) printf '%s\n' "$value"; return 0 ;; esac
    fi
    printf 'none\n'
}

helper_capture_baseline_for_engage() {
    local file; file=$(helper_baseline_file)
    if helper_is_engaged && [[ -f "$file" ]]; then
        return 0
    fi
    local prior; prior=$(helper_read_sleepdisabled)
    printf '%s\n' "$prior" > "$file"
    chmod 0600 "$file" 2>/dev/null || true
    helper_log INFO "captured baseline=$prior"
}

helper_write_response() {
    local id="$1" status="$2" action="$3" message="$4"
    local current baseline tmp response
    current=$(helper_read_sleepdisabled)
    baseline=$(helper_current_baseline)
    response="$HELPER_RESPONSE_DIR/resp.$id"
    tmp="$HELPER_RESPONSE_DIR/.resp.$id.$$"
    {
        printf 'status=%s\n' "$status"
        printf 'action=%s\n' "$action"
        printf 'baseline=%s\n' "$baseline"
        printf 'current=%s\n' "$current"
        printf 'message=%s\n' "$message"
    } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$response"
}

helper_action_engage() {
    helper_capture_baseline_for_engage || return 1
    helper_pmset -a disablesleep 1 || return 1
    helper_mark_engaged || return 1
}

helper_action_release() {
    local baseline target
    if ! helper_is_engaged; then
        helper_log INFO "release requested while idle; no pmset transition needed"
        return 0
    fi
    baseline=$(helper_current_baseline)
    case "$baseline" in
        0|1) target="$baseline" ;;
        *) target="0" ;;
    esac
    helper_pmset -a disablesleep "$target" || return 1
    helper_mark_released || return 1
}

helper_validate_request_file() {
    local path="$1" uid mode nlink
    [[ -e "$path" ]] || return 1
    if [[ -L "$path" ]]; then
        helper_log WARN "reject request path=$path reason=symlink"
        return 1
    fi
    if [[ ! -f "$path" ]]; then
        helper_log WARN "reject request path=$path reason=not_regular"
        return 1
    fi
    uid=$(helper_stat_uid "$path") || return 1
    if [[ "$uid" != "$HELPER_ALLOWED_UID" ]]; then
        helper_log WARN "reject request path=$path uid=$uid expected_uid=$HELPER_ALLOWED_UID reason=owner"
        return 1
    fi
    nlink=$(helper_stat_nlink "$path") || return 1
    if [[ "$nlink" != "1" ]]; then
        helper_log WARN "reject request path=$path nlink=$nlink reason=hardlink"
        return 1
    fi
    mode=$(helper_stat_mode "$path") || return 1
    local owner_digit
    owner_digit="${mode: -3:1}"
    if helper_mode_group_or_other_writable "$mode"; then
        helper_log WARN "reject request path=$path mode=$mode reason=group_or_other_writable"
        return 1
    fi
    case "$owner_digit" in
        0|1|2|3|4|5|6|7) ;;
        *) return 1 ;;
    esac
    return 0
}

helper_request_id_from_base() {
    local base="$1" id
    case "$base" in
        req.*) ;;
        *)
            return 1
            ;;
    esac
    id="${base#req.}"
    [[ "$id" =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    printf '%s\n' "$id"
}

helper_validate_request_dir() {
    local uid mode
    [[ -d "$HELPER_REQUEST_DIR" ]] || {
        helper_log ERROR "request_dir=$HELPER_REQUEST_DIR reason=missing"
        return 1
    }
    uid=$(helper_stat_uid "$HELPER_REQUEST_DIR") || return 1
    if [[ "$uid" != "$HELPER_ALLOWED_UID" ]]; then
        helper_log ERROR "request_dir=$HELPER_REQUEST_DIR uid=$uid expected_uid=$HELPER_ALLOWED_UID reason=owner"
        return 1
    fi
    mode=$(helper_stat_mode "$HELPER_REQUEST_DIR") || return 1
    if helper_mode_group_or_other_writable "$mode"; then
        helper_log ERROR "request_dir=$HELPER_REQUEST_DIR mode=$mode reason=group_or_other_writable"
        return 1
    fi
    return 0
}

helper_reject_processed() {
    local path="$1" id="${2:-unknown}" reason="$3" action="${4:-unknown}"
    helper_log WARN "reject request path=$path uid=${HELPER_ALLOWED_UID:-?} action=$action reason=$reason"
    if [[ "$id" != "unknown" ]]; then
        helper_write_response "$id" "error" "$action" "$reason" || true
    fi
    rm -f "$path"
}

helper_process_request() {
    local path="$1"
    local base id processing_dir moved action extra
    base="$(basename "$path")"
    id=$(helper_request_id_from_base "$base") || {
        helper_log WARN "reject request path=$path reason=bad_filename"
        rm -f "$path"
        return 1
    }

    processing_dir="$HELPER_STATE_DIR/processing"
    mkdir -p "$processing_dir"
    chmod 0700 "$processing_dir" 2>/dev/null || true
    moved="$processing_dir/$base.$$"
    if ! mv "$path" "$moved" 2>/dev/null; then
        return 1
    fi

    if ! helper_validate_request_file "$moved"; then
        helper_reject_processed "$moved" "$id" "invalid_request_file"
        return 1
    fi

    action=""
    extra=""
    {
        IFS= read -r action || true
        IFS= read -r extra || true
    } < "$moved"
    case "$action" in
        engage|release|status) ;;
        *)
            helper_reject_processed "$moved" "$id" "invalid_action" "${action:-empty}"
            return 1
            ;;
    esac
    if [[ -n "$extra" ]]; then
        helper_reject_processed "$moved" "$id" "extra_content" "$action"
        return 1
    fi

    local result="ok" message="ok"
    case "$action" in
        engage)
            if ! helper_action_engage; then
                result="error"; message="pmset_engage_failed"
            fi
            ;;
        release)
            if ! helper_action_release; then
                result="error"; message="pmset_release_failed"
            fi
            ;;
        status)
            ;;
    esac

    helper_write_response "$id" "$result" "$action" "$message"
    helper_log INFO "request path=$moved uid=$HELPER_ALLOWED_UID user=$HELPER_ALLOWED_USER action=$action result=$result message=$message"
    rm -f "$moved"
    [[ "$result" == "ok" ]]
}

helper_process_pending() {
    local found=1 path
    helper_validate_request_dir || return 1
    shopt -s nullglob
    for path in "$HELPER_REQUEST_DIR"/req.*; do
        found=0
        helper_process_request "$path" || true
    done
    shopt -u nullglob
    return "$found"
}

helper_validate_config() {
    [[ -n "$HELPER_REQUEST_DIR" ]] || helper_die "missing --request-dir"
    [[ -n "$HELPER_RESPONSE_DIR" ]] || helper_die "missing --response-dir"
    [[ -n "$HELPER_STATE_DIR" ]] || helper_die "missing --state-dir"
    [[ -n "$HELPER_LOG_FILE" ]] || helper_die "missing --log-file"
    [[ "$HELPER_ALLOWED_UID" =~ ^[0-9]+$ ]] || helper_die "missing/invalid --allowed-uid"
    [[ -n "$HELPER_ALLOWED_USER" ]] || helper_die "missing --allowed-user"
    mkdir -p "$HELPER_RESPONSE_DIR" "$HELPER_STATE_DIR" "$(dirname "$HELPER_LOG_FILE")"
    chmod 0755 "$HELPER_RESPONSE_DIR" 2>/dev/null || true
    chmod 0700 "$HELPER_STATE_DIR" 2>/dev/null || true
}

helper_parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --serve) HELPER_ONCE=0; shift ;;
            --once) HELPER_ONCE=1; shift ;;
            --request-dir) HELPER_REQUEST_DIR="${2:-}"; shift 2 ;;
            --response-dir) HELPER_RESPONSE_DIR="${2:-}"; shift 2 ;;
            --state-dir) HELPER_STATE_DIR="${2:-}"; shift 2 ;;
            --log-file) HELPER_LOG_FILE="${2:-}"; shift 2 ;;
            --allowed-uid) HELPER_ALLOWED_UID="${2:-}"; shift 2 ;;
            --allowed-user) HELPER_ALLOWED_USER="${2:-}"; shift 2 ;;
            --poll-secs) HELPER_POLL_SECS="${2:-}"; shift 2 ;;
            --help|-h) helper_usage; exit 0 ;;
            *) helper_usage; exit 64 ;;
        esac
    done
}

helper_main() {
    helper_parse_args "$@"
    helper_validate_config
    if [[ "${VIGIL_ROOT_HELPER_TESTING:-0}" != "1" && "$(id -u)" != "0" ]]; then
        helper_die "must run as root"
    fi
    helper_log INFO "started request_dir=$HELPER_REQUEST_DIR response_dir=$HELPER_RESPONSE_DIR state_dir=$HELPER_STATE_DIR allowed_uid=$HELPER_ALLOWED_UID allowed_user=$HELPER_ALLOWED_USER once=$HELPER_ONCE"
    if (( HELPER_ONCE == 1 )); then
        helper_process_pending || true
        return 0
    fi
    while true; do
        helper_process_pending || true
        sleep "$HELPER_POLL_SECS"
    done
}

if [[ "${VIGIL_ROOT_HELPER_LIB_ONLY:-0}" != "1" ]]; then
    helper_main "$@"
fi
